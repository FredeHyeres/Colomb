# ════════════════════════════════════════════════════════════
# Variables d'environnement Railway — déploiement démo
# À renseigner dans Railway > Variables du service backend
# ════════════════════════════════════════════════════════════

# Active le mode démo : 3 schémas demo_fr/demo_nl/demo_en, setup.html
# à chaque session, aucune persistance entre visiteurs.
DEMO_MODE=true

# Fournie automatiquement par l'addon PostgreSQL de Railway
# (référence ${{Postgres.DATABASE_URL}} dans Railway).
DATABASE_URL=postgresql://...

# Clé secrète applicative — générer une valeur aléatoire dédiée à la démo.
SECRET_KEY=...

# Origine(s) du frontend autorisée(s) en CORS, séparées par des virgules.
ALLOWED_ORIGINS=https://colomb-demo.railway.app
